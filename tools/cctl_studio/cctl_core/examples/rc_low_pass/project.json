{
  "schema_version": 1,
  "title": "CCTL Studio RC low-pass step response",
  "analysis": {
    "type": "tran",
    "step": "10us",
    "stop": "5ms",
    "start": "0"
  },
  "instances": [
    {
      "name": "VSTEP",
      "module": "spice.voltage_pulse",
      "ports": { "p": "vin", "n": "0" },
      "parameters": {
        "initial": "0",
        "pulsed": "10",
        "rise": "1us",
        "fall": "1us",
        "width": "5ms",
        "period": "10ms"
      }
    },
    {
      "name": "R1",
      "module": "spice.resistor",
      "ports": { "p": "vin", "n": "out" },
      "parameters": { "resistance": "1k" }
    },
    {
      "name": "C1",
      "module": "spice.capacitor",
      "ports": { "p": "out", "n": "0" },
      "parameters": { "capacitance": "1u" }
    }
  ],
  "probes": [
    { "expression": "V(vin)" },
    { "expression": "V(out)" },
    { "expression": "I(VSTEP)" }
  ],
  "output": {
    "format": "CSV",
    "file": "waveforms.csv"
  },
  "editor": {
    "grid_size": 20,
    "snap_to_grid": true,
    "positions": {
      "VSTEP": { "x": 80, "y": 160 },
      "R1": { "x": 300, "y": 80 },
      "C1": { "x": 520, "y": 160 }
    },
    "execution_order": {
      "VSTEP": 1,
      "R1": 2,
      "C1": 3
    },
    "z_order": ["VSTEP", "R1", "C1"],
    "view": { "zoom": 1.0, "pan_x": 80.0, "pan_y": 60.0 },
    "hierarchy": {
      "root_layer": "system_root",
      "layers": {
        "system_root": {
          "id": "system_root",
          "name": "System",
          "kind": "system",
          "nodes": [
            {
              "id": "TOP1",
              "name": "Main Topology",
              "type": "system.electrical_topology",
              "position": { "x": 180.0, "y": 160.0 },
              "parameters": {},
              "execution_order": 1,
              "child_layer": "circuit_main"
            }
          ],
          "connections": [],
          "z_order": ["TOP1"],
          "view": { "zoom": 1.0, "pan_x": 80.0, "pan_y": 70.0 }
        },
        "circuit_main": {
          "id": "circuit_main",
          "name": "Main Topology",
          "kind": "circuit",
          "source": "project.instances",
          "view": { "zoom": 1.0, "pan_x": 80.0, "pan_y": 70.0 }
        }
      }
    }
  }
}

<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ImportGroup Label="PropertySheets" />
  <PropertyGroup Label="UserMacros" />
  <PropertyGroup />
  <ItemDefinitionGroup>
    <PreBuildEvent>
      <Command>if exist "$(ProjectDir)gmp_src_mgr\gmp_generate_src.bat" (
  call "$(ProjectDir)gmp_src_mgr\gmp_generate_src.bat"
) else if exist "$(ProjectDir)gmp_src_mgr\gmp_framework_config.json" (
  pushd "$(ProjectDir)gmp_src_mgr"
  python "$(GMP_PRO_LOCATION)\tools\facilities_generator\src_mgr\framework_sync_src_v3.py"
  if errorlevel 1 exit /b 1
  popd
) else if exist "$(ProjectDir)gmp_fac_generate_src.bat" (
  call "$(ProjectDir)gmp_fac_generate_src.bat"
) else (
  echo [ERROR] GMP source-manager script was not found under $(ProjectDir)
  exit /b 1
)</Command>
    </PreBuildEvent>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup>
    <PreBuildEvent>
      <Message>Generate Facilities files for GMP library.</Message>
    </PreBuildEvent>
  </ItemDefinitionGroup>
  <ItemGroup />
</Project>

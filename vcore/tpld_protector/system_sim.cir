Enorm__pin2 A_norm__pin2 GND VALUE={V(pin2_IN_dynamic1,0)/V(VDD,0)}
ABRIDGE-IN__pin2 [A_norm__pin2] [D_norm_del__pin2] adc_norm
Xdel__pin2 D_norm_del__pin2 D__pin2_OUT DELAY_DIST_LUT

CINA__pin3 pin3_IN_dynamic1 VDD 1.5e-12
CINB__pin3 pin3_IN_dynamic1 GND 1.5e-12
RINA__pin3 pin3_IN_dynamic1 VDD 100000000
RINB__pin3 pin3_IN_dynamic1 GND 100000000
DN__pin3 GND pin3_IN_dynamic1 clamp_diode_1 ; negative clamp
DP__pin3 pin3_IN_dynamic1 VDD clamp_diode_1 ; positive clamp


Enorm__pin3 A_norm__pin3 GND VALUE={V(pin3_IN_dynamic1,0)/V(VDD,0)}
ABRIDGE-IN__pin3 [A_norm__pin3] [D_norm_del__pin3] adc_norm
Xdel__pin3 D_norm_del__pin3 D__pin3_OUT DELAY_DIST_LUT

CINA__pin4 pin4_IN_dynamic1 VDD 1.5e-12
CINB__pin4 pin4_IN_dynamic1 GND 1.5e-12
RINA__pin4 pin4_IN_dynamic1 VDD 100000000
RINB__pin4 pin4_IN_dynamic1 GND 100000000
DN__pin4 GND pin4_IN_dynamic1 clamp_diode_1 ; negative clamp
DP__pin4 pin4_IN_dynamic1 VDD clamp_diode_1 ; positive clamp


Enorm__pin4 A_norm__pin4 GND VALUE={V(pin4_IN_dynamic1,0)/V(VDD,0)}
ABRIDGE-IN__pin4 [A_norm__pin4] [D_norm_del__pin4] adc_norm
Xdel__pin4 D_norm_del__pin4 D__pin4_OUT DELAY_DIST_LUT

CINA__pin5 pin5_IN_dynamic1 VDD 1.5e-12
CINB__pin5 pin5_IN_dynamic1 GND 1.5e-12
RINA__pin5 pin5_IN_dynamic1 VDD 100000000
RINB__pin5 pin5_IN_dynamic1 GND 100000000
DN__pin5 GND pin5_IN_dynamic1 clamp_diode_1 ; negative clamp
DP__pin5 pin5_IN_dynamic1 VDD clamp_diode_1 ; positive clamp


Enorm__pin5 A_norm__pin5 GND VALUE={V(pin5_IN_dynamic1,0)/V(VDD,0)}
ABRIDGE-IN__pin5 [A_norm__pin5] [D_norm_del__pin5] adc_norm
Xdel__pin5 D_norm_del__pin5 D__pin5_OUT DELAY_DIST_LUT

* Leakage current at outputs:
R_pin7POSOUTLEAK pin7_OUT_dynamic1 VDD 5e+7
R_pin7NEGOUTLEAK pin7_OUT_dynamic1 GND 5e+7
COUTA__pin7 pin7_OUT_dynamic1 VDD 1.5e-12
COUTB__pin7 pin7_OUT_dynamic1 GND 1.5e-12
ROUTA__pin7 pin7_OUT_dynamic1 VDD 100000000
ROUTB__pin7 pin7_OUT_dynamic1 GND 100000000

R_pin7_OE A_ONE A__pin7_HIZ 1
ABRIDGE-OUT__pin7 [D__lut4_OUT] [A_I__pin7] dac_pin_out
EOUT__pin7 A_OUT_INT__pin7 GND VALUE = {V(A_I__pin7)*V(VDD,GND)}
GOUT__pin7 pin7_OUT_dynamic1 A_OUT_INT__pin7 VALUE = { V(A_STARTUP)*V(A__pin7_HIZ)*(
+ 1*V(A_I__pin7)*V(pin7_OUT_dynamic1,A_OUT_INT__pin7)/V(ROH1X)+
+ 1*(1-V(A_I__pin7))*V(pin7_OUT_dynamic1,A_OUT_INT__pin7)/V(ROL1X)
+ )}

CINA__pin8 pin8_IN_dynamic1 VDD 1.5e-12
CINB__pin8 pin8_IN_dynamic1 GND 1.5e-12
RINA__pin8 pin8_IN_dynamic1 VDD 100000000
RINB__pin8 pin8_IN_dynamic1 GND 100000000
DN__pin8 GND pin8_IN_dynamic1 clamp_diode_1 ; negative clamp
DP__pin8 pin8_IN_dynamic1 VDD clamp_diode_1 ; positive clamp


Enorm__pin8 A_norm__pin8 GND VALUE={V(pin8_IN_dynamic1,0)/V(VDD,0)}
ABRIDGE-IN__pin8 [A_norm__pin8] [D_norm_del__pin8] adc_norm
Xdel__pin8 D_norm_del__pin8 D__pin8_OUT DELAY_DIST_LUT

* Leakage current at outputs:
R_pin9POSOUTLEAK pin9_OUT_dynamic1 VDD 5e+7
R_pin9NEGOUTLEAK pin9_OUT_dynamic1 GND 5e+7
COUTA__pin9 pin9_OUT_dynamic1 VDD 1.5e-12
COUTB__pin9 pin9_OUT_dynamic1 GND 1.5e-12
ROUTA__pin9 pin9_OUT_dynamic1 VDD 100000000
ROUTB__pin9 pin9_OUT_dynamic1 GND 100000000

R_pin9_OE A_ONE A__pin9_HIZ 1
ABRIDGE-OUT__pin9 [D__lut5_OUT] [A_I__pin9] dac_pin_out
EOUT__pin9 A_OUT_INT__pin9 GND VALUE = {V(A_I__pin9)*V(VDD,GND)}
GOUT__pin9 pin9_OUT_dynamic1 A_OUT_INT__pin9 VALUE = { V(A_STARTUP)*V(A__pin9_HIZ)*(
+ 1*V(A_I__pin9)*V(pin9_OUT_dynamic1,A_OUT_INT__pin9)/V(ROH1X)+
+ 1*(1-V(A_I__pin9))*V(pin9_OUT_dynamic1,A_OUT_INT__pin9)/V(ROL1X)
+ )}

CINA__SCL SCL_IN_dynamic1 VDD 1.5e-12
CINB__SCL SCL_IN_dynamic1 GND 1.5e-12
RINA__SCL SCL_IN_dynamic1 VDD 100000000
RINB__SCL SCL_IN_dynamic1 GND 100000000
DN__SCL GND SCL_IN_dynamic1 clamp_diode_1 ; negative clamp
DP__SCL SCL_IN_dynamic1 VDD clamp_diode_1 ; positive clamp


Enorm__SCL A_norm__SCL GND VALUE={V(SCL_IN_dynamic1,0)/V(VDD,0)}
ABRIDGE-IN__SCL [A_norm__SCL] [D_norm_del__SCL] adc_norm
Xdel__SCL D_norm_del__SCL D__SCL_OUT DELAY_DIST_LUT

CINA__SDA SDA_IN_dynamic1 VDD 1.5e-12
CINB__SDA SDA_IN_dynamic1 GND 1.5e-12
RINA__SDA SDA_IN_dynamic1 VDD 100000000
RINB__SDA SDA_IN_dynamic1 GND 100000000
DN__SDA GND SDA_IN_dynamic1 clamp_diode_1 ; negative clamp
DP__SDA SDA_IN_dynamic1 VDD clamp_diode_1 ; positive clamp


Enorm__SDA A_norm__SDA GND VALUE={V(SDA_IN_dynamic1,0)/V(VDD,0)}
ABRIDGE-IN__SDA [A_norm__SDA] [D_norm_del__SDA] adc_norm
Xdel__SDA D_norm_del__SDA D__SDA_OUT DELAY_DIST_LUT

* Leakage current at outputs:
R_pin6POSOUTLEAK pin6_OUT_dynamic1 VDD 5e+7
R_pin6NEGOUTLEAK pin6_OUT_dynamic1 GND 5e+7
COUTA__pin6 pin6_OUT_dynamic1 VDD 1.5e-12
COUTB__pin6 pin6_OUT_dynamic1 GND 1.5e-12
ROUTA__pin6 pin6_OUT_dynamic1 VDD 100000000
ROUTB__pin6 pin6_OUT_dynamic1 GND 100000000

R_pin6_OE A_ONE A__pin6_HIZ 1
ABRIDGE-OUT__pin6 [D__lut11_OUT] [A_I__pin6] dac_pin_out
EOUT__pin6 A_OUT_INT__pin6 GND VALUE = {V(A_I__pin6)*V(VDD,GND)}
GOUT__pin6 pin6_OUT_dynamic1 A_OUT_INT__pin6 VALUE = { V(A_STARTUP)*V(A__pin6_HIZ)*(
+ 1*V(A_I__pin6)*V(pin6_OUT_dynamic1,A_OUT_INT__pin6)/V(ROH1X)+
+ 1*(1-V(A_I__pin6))*V(pin6_OUT_dynamic1,A_OUT_INT__pin6)/V(ROL1X)
+ )}

* Leakage current at outputs:
R_pin10POSOUTLEAK pin10_OUT_dynamic1 VDD 5e+7
R_pin10NEGOUTLEAK pin10_OUT_dynamic1 GND 5e+7
COUTA__pin10 pin10_OUT_dynamic1 VDD 1.5e-12
COUTB__pin10 pin10_OUT_dynamic1 GND 1.5e-12
ROUTA__pin10 pin10_OUT_dynamic1 VDD 100000000
ROUTB__pin10 pin10_OUT_dynamic1 GND 100000000

R_pin10_OE A_ONE A__pin10_HIZ 1
ABRIDGE-OUT__pin10 [D__lut13_OUT] [A_I__pin10] dac_pin_out
EOUT__pin10 A_OUT_INT__pin10 GND VALUE = {V(A_I__pin10)*V(VDD,GND)}
GOUT__pin10 pin10_OUT_dynamic1 A_OUT_INT__pin10 VALUE = { V(A_STARTUP)*V(A__pin10_HIZ)*(
+ 1*V(A_I__pin10)*V(pin10_OUT_dynamic1,A_OUT_INT__pin10)/V(ROH1X)+
+ 1*(1-V(A_I__pin10))*V(pin10_OUT_dynamic1,A_OUT_INT__pin10)/V(ROL1X)
+ )}

* Leakage current at outputs:
R_pin11POSOUTLEAK pin11_OUT_dynamic1 VDD 5e+7
R_pin11NEGOUTLEAK pin11_OUT_dynamic1 GND 5e+7
COUTA__pin11 pin11_OUT_dynamic1 VDD 1.5e-12
COUTB__pin11 pin11_OUT_dynamic1 GND 1.5e-12
ROUTA__pin11 pin11_OUT_dynamic1 VDD 100000000
ROUTB__pin11 pin11_OUT_dynamic1 GND 100000000

R_pin11_OE A_ONE A__pin11_HIZ 1
ABRIDGE-OUT__pin11 [D__lut12_OUT] [A_I__pin11] dac_pin_out
EOUT__pin11 A_OUT_INT__pin11 GND VALUE = {V(A_I__pin11)*V(VDD,GND)}
GOUT__pin11 pin11_OUT_dynamic1 A_OUT_INT__pin11 VALUE = { V(A_STARTUP)*V(A__pin11_HIZ)*(
+ 1*V(A_I__pin11)*V(pin11_OUT_dynamic1,A_OUT_INT__pin11)/V(ROH1X)+
+ 1*(1-V(A_I__pin11))*V(pin11_OUT_dynamic1,A_OUT_INT__pin11)/V(ROL1X)
+ )}


*// PIPEDELAY //*



*// POR //*
VSTARTUP A_STARTUP GND PWL(0 0 {1n-1p} 0 1n 1)
ASTARTUP [A_STARTUP] [D_STARTUP] adc_ideal


*// VCC //*
VA_ONE A_ONE GND 1
ABRIDGE_DONE [A_ONE] [D_ONE] adc_ideal


*// VREF //*


*// WAVE //*


*// Models //*
.model adc_ideal adc_bridge(in_low = 0.5 in_high = 0.5 rise_delay=1e-12 fall_delay=1e-12)
.model dac_ideal dac_bridge(out_low=0 out_high=1 out_undef=0 input_load=1e-15 t_rise=1e-12 t_fall=1e-12)
.model dac_pin_out dac_bridge(out_low=0 out_high=1 out_undef=0 input_load=1e-15 t_rise=1e-8 t_fall=1e-8)
.model buf_ideal d_buffer(rise_delay=1e-12 fall_delay=1e-12 input_load=1e-15)
.model and_ideal d_and(rise_delay=1e-12 fall_delay=1e-12 input_load=1e-15)
.model or_ideal d_or(rise_delay=1e-12 fall_delay=1e-12 input_load=1e-15)
.model inv_ideal d_inverter(rise_delay=1e-12 fall_delay=1e-12 input_load=1e-15)
.model buf_del_1ns d_buffer(rise_delay=1e-9 fall_delay=1e-9 input_load=1e-15)
.model and_del_1ns d_and(rise_delay=1e-9 fall_delay=1e-9 input_load=1e-15)
.model or_del_1ns d_or(rise_delay=1e-9 fall_delay=1e-9 input_load=1e-15)
.model inv_del_1ns d_inverter(rise_delay=1e-9 fall_delay=1e-9 input_load=1e-15)
.model xor_ideal d_xor(rise_delay=1e-12 fall_delay=1e-12 input_load=1e-15)
.model hyst_pdly hyst(in_low=0.5 in_high=0.5 hyst={0.19153} out_lower_limit=0 out_upper_limit=1 input_domain=0.01 fraction=TRUE)
.model dff_ideal d_dff(clk_delay=1e-12 set_delay=1e-12 reset_delay=1e-12 ic=0 rise_delay=1e-12 fall_delay=1e-12)    
.model adc_norm adc_bridge(in_low = 0.5 in_high = 0.5 rise_delay='1e-9' fall_delay='1e-9')
.model adc_lv_norm adc_bridge(in_low = 0.3 in_high = 0.3 rise_delay='1e-9' fall_delay='1e-9')
.model hyst_norm hyst(in_low=0.5 in_high=0.5 hyst=0.1 out_lower_limit=0 out_upper_limit=1 input_domain=0.01 fraction=TRUE)
.model clamp_diode_1 D (IS=35p RS=64m BV=75 CJO=4p M=0.285 N=1.24)
.ENDS




*// Output and plotting //*


.model dac_ideal dac_bridge(out_low=0 out_high=1 out_undef=0 input_load=1e-15 t_rise=1e-12 t_fall=1e-12)



.control
save 
tran 9.999999999999999e-6 1e-2 0e+0 
* step units: us
* step value: 0.000009999999999999999
plot  xlimit 0e+0 1e-2
.endc




*// Sub-circuits required for operation //*
* Nanoseconds - 10 segment distributed delay (up to one full period of delay)
* 7
.SUBCKT DELAY_DIST_LUT IN OUT
.model dist_dly_buff d_buffer(rise_delay = 3.5n fall_delay = 3.5n)
A_out_buff IN OUT dist_dly_buff
.ENDS DELAY_DIST_LUT

.SUBCKT LOGIC_TRI_STATE_OUTPUT IN OUT OEZ VCC VEE
EROH NROH VEE TABLE {V(VCC,VEE)} = 
+ (1.8,61)
+ (3.3,50)
+ (5,37)
EROL NROL VEE TABLE {V(VCC,VEE)} = 
+ (1.8,18)
+ (3.3,14)
+ (5,9) 
EOEZ N2 VEE VALUE = {V(OEZ,VEE)} 
E1 N1 VEE VALUE = {V(VCC,VEE)*V(IN,VEE)*V(N2,VEE)} 
GOUT N1 OUT VALUE = {V(N1,OUT)*V(N2,VEE)*(V(IN,VEE)/V(NROH,VEE) + (1 - V(IN,VEE))/V(NROL,VEE))} 
ROUT OUT VEE 1E8 
.ENDS 

.SUBCKT SUPPLY_CURRENT VCC VEE
+ PARAMS:
+  ICC = 100n
+  VMAX = 5.5
+  VMIN = 1.65
.PARAM RCC = VMAX/ICC
GICC VCC VEE VALUE = {IF(V(VCC,VEE)<VMIN,1,0)*V(VCC,VEE)/RCC}
.ENDS

.end

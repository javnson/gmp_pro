{
  "id": "pgs_sinv_rc_simulate",
  "macro_prefix": "PGS_SINV_RC_SIM",
  "display_name": "PGS SINV RC MATLAB/Simulink SIL",
  "description": "Windows SIL platform, plant and sensing settings for all SINV commissioning models.",
  "suite": "pgs_sinv_rc",
  "version": "1.0.0",
  "updated_at": "2026-08-15",
  "output_header": "ctrl_settings.h",
  "hardware": [
    {
      "role": "power_stage",
      "entity": "gmp_lvfb_150_2ph_v2"
    },
    {
      "role": "grid_filter",
      "entity": "gmp_harmonia_3ph_lc_filter"
    }
  ],
  "code_sections": {
    "after_extern_open": "#define SPECIFY_PC_ENVIRONMENT",
    "before_footer": "#if (BUILD_LEVEL < 1) || (BUILD_LEVEL > 5)\n#error BUILD_LEVEL_must_be_between_1_and_5\n#endif"
  },
  "feature_macros": [
    {
      "group": "SIL Runtime",
      "macro": "SINV_SIM_AUTO_ENABLE",
      "enabled": true,
      "value": "",
      "description": "Automatically request CiA402 ENABLE_OPERATION in the simulation executable."
    },
    {
      "group": "SIL Runtime",
      "macro": "SPECIFY_ENABLE_ADC_CALIBRATE",
      "enabled": false,
      "value": "",
      "description": "Simulated sensor ADC offsets are deterministic and do not require startup calibration."
    },
    {
      "group": "SIL Runtime",
      "macro": "ENABLE_GMP_DL_PIL_SIM",
      "enabled": false,
      "value": "",
      "description": "Use the native ASIO UDP SIL path instead of datalink PIL."
    }
  ],
  "option_macros": [
    {
      "group": "Commissioning",
      "macro": "BUILD_LEVEL",
      "enabled": true,
      "value": "(2)",
      "options": [
        "(1)",
        "(2)",
        "(3)",
        "(4)",
        "(5)"
      ],
      "description": "Single-phase converter commissioning level.\nBUILD_LEVEL 1: open-loop sinusoidal H-bridge voltage on an isolated resistive load; validates ADC polarity, PWM mapping and the power stage without a current loop.\nBUILD_LEVEL 2: closed AC-current loop on an isolated resistive load; validates QPR tracking, grid-voltage feedforward and optional FDRC.\nBUILD_LEVEL 3: grid-connected signed P/Q command through the current loop; positive P exports power and negative P rectifies.\nBUILD_LEVEL 4: grid-connected measured-active-power outer loop feeding the current loop.\nBUILD_LEVEL 5: active-front-end rectifier with a DC-bus voltage outer loop; takeover is initialized from the measured passive-rectifier power."
    }
  ],
  "requirements": [

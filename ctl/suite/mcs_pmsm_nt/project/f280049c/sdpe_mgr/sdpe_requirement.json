      "weak": false,
      "binding": {
        "number": "100"
      },
      "description": "Dead-time count interpreted in the selected PWM peripheral clock domain."
    },
    {
      "role": "System Frequency",
      "macro": "CTRL_SYS_FREQUENCY",
      "enabled": true,
      "weak": false,
      "binding": {
        "number": "100e6"
      },
      "description": "Platform CPU or system clock frequency in hertz."
    },
    {
      "role": "System Time Divider",
      "macro": "DSP_C2000_DSP_TIME_DIV",
      "enabled": true,
      "weak": false,
      "binding": {
        "number": "CTRL_SYS_FREQUENCY / 1000 / CTRL_PWM_CMP_MAX / 2"
      },
      "description": "C2000 millisecond system-tick divider derived from the CPU clock and ePWM period."

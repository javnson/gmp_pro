  "code_sections": {
    "before_footer": "/* Platform-specific peripheral selection and validation. */\n#if MCS_PWM_TIMER_SELECTION == 1\n#define MCS_PWM_TIMER_HANDLE (&htim1)\n#define MCS_PWM_ADC_TRIGGER ADC_EXTERNALTRIGINJEC_T1_TRGO\n#elif MCS_PWM_TIMER_SELECTION == 8\n#define MCS_PWM_TIMER_HANDLE (&htim8)\n#define MCS_PWM_ADC_TRIGGER ADC_EXTERNALTRIGINJEC_T8_TRGO\n#else\n#error \"MCS_PWM_TIMER_SELECTION must be 1 or 8.\"\n#endif"
  },
  "feature_macros": [],
  "option_macros": [
    {
      "group": "ADC",
      "macro": "MC_CURRENT_SAMPLE_PHASE_MODE",
      "enabled": true,
      "value": "(3)",
      "options": [
        "(2)",
        "(3)"
      ],
      "description": "Directly sampled phase-current count."
    },
    {
      "group": "Board",
      "macro": "MCS_PWM_TIMER_SELECTION",
      "enabled": true,
      "value": "1",
      "options_preset": "nucleo_g431rb_motor_board.PWM_TIMER_SELECTION",
      "options": [],
      "description": "Select TIM1 or TIM8 as the complete three-phase PWM and ADC trigger source."
    },
    {
      "group": "Board",
      "macro": "MCS_UART_HANDLE",
      "enabled": true,
      "value": "(&huart2)",
      "options_preset": "nucleo_g431rb_motor_board.UART_HANDLE",
      "options": [],
      "description": "Datalink UART handle."
    },
    {
      "group": "Board",
      "macro": "MCS_UART_INSTANCE",
      "enabled": true,
      "value": "USART2",
      "options": [
        "USART2"
      ],
      "description": "Datalink UART instance."
    },
    {
      "group": "Board",
      "macro": "MCS_ENCODER_TIMER_HANDLE",
      "enabled": true,
      "value": "(&htim3)",
      "options": [
        "(&htim3)"
      ],
      "description": "Encoder timer handle."
    }
  ],

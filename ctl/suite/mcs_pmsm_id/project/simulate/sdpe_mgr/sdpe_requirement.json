{
  "id": "mcs_pmsm_id_simulate",
  "macro_prefix": "MCS_PMSM_ID_SIMULATE",
  "display_name": "MCS PMSM Identification simulate",
  "suite": "mcs_pmsm_id",
  "version": "1.0.0",
  "output_header": "ctrl_settings.h",
  "hardware": [
    {
      "entity": "ti_boostxl_3phganinv"
    }
  ],
  "requirements": [
    {
      "role": "Pwm Compare Max",
      "macro": "CTRL_PWM_CMP_MAX",
      "binding": {
        "literal": "(2500 - 1)"
      },
      "description": "Maximum compare count of the platform PWM peripheral at the configured controller switching frequency."
    },
    {
      "role": "Pwm Deadband",
      "macro": "CTRL_PWM_DEADBAND_CMP",
      "binding": {
        "number": "100"
      },
      "description": "Dead-time count interpreted in the selected PWM peripheral clock domain."
    },
    {
      "role": "System Frequency",
      "macro": "CTRL_SYS_FREQUENCY",
      "binding": {
        "literal": "(CONTROLLER_FREQUENCY)"
      },
      "description": "Platform CPU or system clock frequency in hertz."
    },
    {
      "role": "Adc Voltage Reference",
      "macro": "CTRL_ADC_VOLTAGE_REF",
      "binding": {
        "parameter": "3.3"
      },
      "description": "ADC reference voltage used by all sensor conversions."
    },
    {
      "role": "Dc Bus Voltage Base",
      "macro": "CTRL_DCBUS_VOLTAGE",
      "binding": {
        "parameter": "24.0"
      },
      "description": "Configured DC-bus voltage base."
    },
    {
      "role": "Phase Voltage Base",
      "macro": "CTRL_VOLTAGE_BASE",
      "binding": {
        "literal": "(CTRL_DCBUS_VOLTAGE / 1.73205081f)"
      },
      "description": "Phase-voltage per-unit base derived from the DC-bus base."
    },
    {
      "role": "Current Base",
      "macro": "CTRL_CURRENT_BASE",
      "binding": {
        "parameter": "10.0"
      },
      "description": "Phase-current per-unit base in amperes."
    },
    {
      "role": "Encoder Full Scale",
      "macro": "CTRL_POS_ENC_FS",
      "binding": {
        "number": "16384"
      },
      "description": "Encoder counts per mechanical revolution."
    },
    {
      "role": "Encoder Bias",
      "macro": "CTRL_POS_ENC_BIAS",
      "binding": {
        "parameter": "0.0999145508"
      },
      "description": "Mechanical encoder position bias in per unit."
    },
    {
      "role": "Mechanical Division",
      "macro": "CTRL_MECH_DIV",
      "binding": {
        "number": "5"
      },
      "description": "Mechanical speed and position division factor."
    },
    {
      "role": "Phase Current Sensitivity",
      "macro": "CTRL_INVERTER_CURRENT_SENSITIVITY",
      "binding": {
        "parameter": "0.1"
      },
      "description": "Match the simulation ADC current path: 5 mOhm shunt times 20 V/V gain."
    },
    {
      "role": "Phase Current Bias",
      "macro": "CTRL_INVERTER_CURRENT_BIAS",
      "binding": {
        "parameter": "1.65"
      },
      "description": "Match the 1.65 V zero-current bias configured in MCS_STD_PMSM_MODEL.slx."
    },
    {
      "role": "Phase Voltage Sensitivity",
      "macro": "CTRL_INVERTER_VOLTAGE_SENSITIVITY",
      "binding": {
        "parameter": "0.04049127"
      },
      "description": "Match the phase-voltage gain configured in MCS_STD_PMSM_MODEL.slx."
    },
    {
      "role": "Phase Voltage Bias",
      "macro": "CTRL_INVERTER_VOLTAGE_BIAS",
      "binding": {
        "parameter": "0.0"
      },
      "description": "The simulation phase-voltage path has zero bias."
    },
    {
      "role": "Dc Current Sensitivity",
      "macro": "CTRL_DC_CURRENT_SENSITIVITY",
      "binding": {
        "parameter": "1.0"
      },
      "description": "Unity placeholder for the unused simulation DC-current path."
    },
    {
      "role": "Dc Current Bias",
      "macro": "CTRL_DC_CURRENT_BIAS",
      "binding": {
        "parameter": "0.0"
      },
      "description": "The unused simulation DC-current path has zero bias."
    },
    {
      "role": "Dc Voltage Sensitivity",
      "macro": "CTRL_DC_VOLTAGE_SENSITIVITY",
      "binding": {
        "parameter": "0.04049127"
      },
      "description": "Match the DC-bus voltage gain configured in MCS_STD_PMSM_MODEL.slx."
    },
    {
      "role": "Dc Voltage Bias",
      "macro": "CTRL_DC_VOLTAGE_BIAS",
      "binding": {
        "parameter": "0.0"
      },
      "description": "The simulation DC-bus voltage path has zero bias."
    },
    {
      "role": "Motor Type",
      "macro": "MOTOR_TYPE",
      "enabled": true,
      "weak": false,
      "binding": {
        "literal": "(PMSM_MOTOR)"
      },
      "description": "Match the PMSM type configured in MCS_STD_PMSM_MODEL.slx."
    },
    {
      "role": "Motor Stator Resistance",
      "macro": "MOTOR_PARAM_RS",
      "enabled": true,
      "weak": false,
      "binding": {
        "parameter": "4.7"
      },
      "description": "Match the per-phase resistance configured in the Simulink PMSM block."
    },
    {
      "role": "Motor Stator Inductance",
      "macro": "MOTOR_PARAM_LS",
      "enabled": true,
      "weak": false,
      "binding": {
        "parameter": "8.5e-3"
      },
      "description": "Match the per-phase inductance configured in the Simulink PMSM block."
    },
    {
      "role": "Motor D-axis Inductance",
      "macro": "MOTOR_PARAM_LD",
      "enabled": true,
      "weak": false,
      "binding": {
        "parameter": "8.5e-3"
      },
      "description": "Match the d-axis inductance configured in the Simulink PMSM block."
    },
    {
      "role": "Motor Q-axis Inductance",
      "macro": "MOTOR_PARAM_LQ",
      "enabled": true,
      "weak": false,
      "binding": {
        "parameter": "8.5e-3"
      },
      "description": "Match the q-axis inductance configured in the Simulink PMSM block."
    },
    {
      "role": "Motor Flux Linkage",
      "macro": "MOTOR_PARAM_FLUX",
      "enabled": true,
      "weak": false,
      "binding": {
        "parameter": "0.0038197"
      },
      "description": "Match the flux linkage configured in the Simulink PMSM block."
    },
    {
      "role": "Motor Pole Pairs",
      "macro": "MOTOR_PARAM_POLE_PAIRS",
      "enabled": true,
      "weak": false,
      "binding": {
        "number": "4"
      },
      "description": "Match the pole-pair count configured in the Simulink PMSM block."
    },
    {
      "role": "Motor Velocity Constant",
      "macro": "MOTOR_PARAM_KV",
      "enabled": true,
      "weak": false,
      "binding": {
        "parameter": "206.2"
      },
      "description": "Velocity constant corresponding to the Simulink PMSM mask."
    },
    {
      "role": "Motor Back EMF",
      "macro": "MOTOR_PARAM_EMF",
      "enabled": true,
      "weak": false,
      "binding": {
        "literal": "(1000.0f / 206.2f)"
      },
      "description": "Line-line peak back-EMF constant configured in the Simulink PMSM mask."
    },
    {
      "role": "Motor Rated Voltage",
      "macro": "MOTOR_PARAM_RATED_VOLTAGE",
      "enabled": true,
      "weak": false,
      "binding": {
        "literal": "(24.0f / 1.73205081f)"
      },
      "description": "Available phase-voltage limit for the 24 V simulated DC bus."
    },
    {
      "role": "Motor No-load Current",
      "macro": "MOTOR_PARAM_NO_LOAD_CURRENT",
      "enabled": true,
      "weak": false,
      "binding": {
        "parameter": "0.0"
      },
      "description": "No-load current default for the idealized Simulink plant."
    },
    {
      "role": "Motor Rated Frequency",
      "macro": "MOTOR_PARAM_RATED_FREQUENCY",
      "enabled": true,
      "weak": false,
      "binding": {
        "parameter": "200.0"
      },
      "description": "Electrical base frequency at 3000 rpm and four pole pairs."
    },
    {
      "role": "Motor Maximum Speed",
      "macro": "MOTOR_PARAM_MAX_SPEED",
      "enabled": true,
      "weak": false,
      "binding": {
        "parameter": "3000.0"
      },
      "description": "Mechanical speed base used by the simulated encoder and controller."
    },
    {
      "role": "Motor Maximum Torque",
      "macro": "MOTOR_PARAM_MAX_TORQUE",
      "enabled": true,
      "weak": false,
      "binding": {
        "parameter": "0.2"
      },
      "description": "Conservative torque limit for the small simulated PMSM."
    },
    {
      "role": "Motor Maximum DC Voltage",
      "macro": "MOTOR_PARAM_MAX_DC_VOLTAGE",
      "enabled": true,
      "weak": false,
      "binding": {
        "parameter": "24.0"
      },
      "description": "DC-bus voltage configured by the model source."
    },
    {
      "role": "Motor Maximum Phase Current",
      "macro": "MOTOR_PARAM_MAX_PH_CURRENT",
      "enabled": true,
      "weak": false,
      "binding": {
        "parameter": "10.0"
      },
      "description": "Phase-current base and conservative simulated current limit."
    },
    {
      "role": "Controller Frequency",
      "macro": "CONTROLLER_FREQUENCY",
      "enabled": true,
      "weak": false,
      "binding": {
        "parameter": "20e3"
      },
      "description": "Main motor-control ISR frequency in hertz."
    },
    {
      "role": "Startup Delay",
      "macro": "CTRL_STARTUP_DELAY",
      "enabled": true,
      "weak": false,
      "binding": {
        "number": "100"
      },
      "description": "Controller startup delay in milliseconds."
    },
    {
      "role": "ADC Calibration Timeout",
      "macro": "TIMEOUT_ADC_CALIB_MS",
      "enabled": true,
      "weak": false,
      "binding": {
        "number": "10000"
      },
      "description": "Migrated from simulate/xplt/ctrl_settings.h."
    }
  ],

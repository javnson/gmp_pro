    {
      "role": "Max DC Bus Voltage",
      "macro": "MCS_MAX_DC_BUS_VOLTAGE_V",
      "enabled": true,
      "weak": true,
      "binding": {
        "literal": "(CTRL_DCBUS_VOLTAGE*1.2f)"

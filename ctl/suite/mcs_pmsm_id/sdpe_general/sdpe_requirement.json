{
  "id": "mcs_pmsm_id_common",
  "macro_prefix": "MCS_PMSM_ID_COMMON",
  "display_name": "MCS PMSM Identification Common Control",
  "description": "Platform-independent motor-control, protection, commissioning and runtime defaults shared by mcs_pmsm_id targets.",
  "suite": "mcs_pmsm_id",
  "version": "1.0.0",
  "updated_at": "2026-08-14",
  "output_header": "sdpe_mcs_pmsm_id_common_settings.h",
  "hardware": [],
  "code_sections": {
    "after_extern_open": "/* Platform-independent settings only. Project hardware is supplied by the including project header. */",
    "before_footer": "/* Accept the historical misspelling while all source code uses the canonical switch. */\n#if defined ENBALE_GMP_DL_PIL_SIM && !defined ENABLE_GMP_DL_PIL_SIM\n#define ENABLE_GMP_DL_PIL_SIM\n#endif\n\n/* Reject unsupported incremental build levels at preprocessing time. */\n#if (BUILD_LEVEL < 1) || (BUILD_LEVEL > 4)\n#error \"BUILD_LEVEL must be 1 (V/f), 2 (current loop/synthetic angle), 3 (current loop/encoder), or 4 (speed loop).\"\n#endif"
  },
  "feature_macros": [
    {
      "group": "Control Algorithm",
      "macro": "_USE_DEBUG_DISCRETE_PID",
      "enabled": false,
      "weak": true,
      "value": "",
      "description": "Enable the existing discrete-PID anti-saturation debug path."
    },
    {
      "group": "Control Algorithm",
      "macro": "PMSM_CTRL_USING_DISCRETE_CTRL",
      "enabled": false,
      "weak": true,
      "value": "",
      "description": "Use the discrete controller implementation instead of the default continuous controller path."
    },
    {
      "group": "Control Algorithm",
      "macro": "ENABLE_SMO",
      "enabled": false,
      "weak": true,
      "value": "",
      "description": "Enable the sliding-mode observer path. Disabled to preserve the current sensored-control build."
    },
    {
      "group": "Protection",
      "macro": "ENABLE_MOTOR_FAULT_PROTECTION",
      "enabled": false,
      "weak": true,
      "value": "",
      "description": "Enable motor fault protection processing."
    },
    {
      "group": "Sensing and Calibration",
      "macro": "SPECIFY_ENABLE_ADC_CALIBRATE",
      "enabled": false,
      "weak": true,
      "value": "",
      "description": "Calibrate ADC offsets before enabling normal control."
    },
    {
      "group": "Controller Runtime",
      "macro": "GMP_CTL_FM_CONFIG_ENABLE_DEBUG_INFO",
      "enabled": false,
      "weak": true,
      "value": "",
      "description": "Enable CiA402/GMP framework debug information."
    },
    {
      "group": "PWM Modulator",
      "macro": "PWM_MODULATOR_USING_NEGATIVE_LOGIC",
      "enabled": false,
      "weak": true,
      "value": "(1)",
      "description": "Use active-low PWM modulation for the selected inverter gate path."
    },
    {
      "group": "PWM Modulator",
      "macro": "USING_NPC_MODULATOR",
      "enabled": false,
      "weak": true,
      "value": "",
      "description": "Use the three-level NPC modulator. Disabled for the two-level three-phase inverter."
    }
  ],
  "option_macros": [
    {
      "group": "Commissioning",
      "macro": "BUILD_LEVEL",
      "enabled": true,
      "weak": true,
      "value": "(2)",
      "options_preset": "",
      "options": [
        "(1)",
        "(2)",
        "(3)",
        "(4)",
        "(5)",
        "(6)"
      ],
      "description": "Incremental commissioning level. 1: V/f voltage open loop; 2: current loop with synthetic electrical angle; 3: current loop with encoder angle; 4: speed loop with encoder feedback."
    }
  ],
  "requirements": [
    {
      "role": "Controller Frequency",
      "macro": "CONTROLLER_FREQUENCY",
      "enabled": true,
      "weak": true,
      "binding": {
        "float": "20e3"
      },
      "description": "Main motor-control ISR frequency in hertz."
    },
    {
      "role": "PWM DT Current Deadband",
      "macro": "MCS_PWM_DEADTIME_COMP_CURRENT_DEADBAND_A",
      "enabled": true,
      "weak": true,
      "binding": {
        "float": "0.2"
      },
      "description": "Minimum absolute phase current in amperes before PWM dead-time compensation selects a current direction. Converted to PU with CTRL_CURRENT_BASE at initialization."
    },
    {
      "role": "PWM DT Current Hysteresis",
      "macro": "MCS_PWM_DEADTIME_COMP_CURRENT_HYSTERESIS_A",
      "enabled": true,
      "weak": true,
      "binding": {
        "float": "0.05"
      },
      "description": "Phase-current hysteresis band in amperes used to prevent dead-time compensation direction chatter around zero current."
    },

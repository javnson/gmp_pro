/**
 * @cliArgs --device "F28004x" --part "F28004x_100PZ" --package "F28004x_100PZ" --context "system" --product "gmp_pro@1.00.00.05" --product "C2000WARE@5.04.00.00"
 * @v2CliArgs --device "TMS320F280049C" --package "100PZ" --context "system" --product "gmp_pro@1.00.00.05" --product "C2000WARE@5.04.00.00"
 */

const device = scripting.addModule("/driverlib/device_support.js");
device.useStandardCodeStartBranch = false;
system.clockTree["PLL_IMULT"].multiplyValue = 10;
system.clockTree["OSCCLKSRCSEL"].inputSelect = "X1_XTAL";

const asysctl = scripting.addModule("/driverlib/asysctl.js");
asysctl.analogReference = "INTERNAL";
asysctl.analogReferenceVoltage = "1P65"; // 3.3 V conversion range

const adc = scripting.addModule("/driverlib/adc.js", {}, false);
function addAdc(name, base, channel, sampleWindow) {
    const instance = adc.addInstance();
    instance.$name = name;
    instance.adcBase = base;
    instance.adcClockPrescaler = "ADC_CLK_DIV_2_0";
    instance.interruptPulseMode = "ADC_PULSE_END_OF_CONV";
    instance.enabledSOCs = ["ADC_SOC_NUMBER0"];
    instance.soc0Channel = channel;
    instance.soc0SampleWindow = sampleWindow;
    instance.soc0Trigger = "ADC_TRIGGER_EPWM1_SOCA";
    return instance;
}

// The longer ADCA acquisition makes its EOC arrive after the parallel B/C results.
const il = addAdc("FSBB_IL_ADC", "ADCA_BASE", "ADC_CH_ADCIN6", 64);
il.enabledInts = ["ADC_INT_NUMBER1"];
il.enableInterrupt1 = true;
il.registerInterrupts = ["1"];
il.adcInt1.enableInterrupt = true;
il.adcInt1.interruptHandler = "MainISR";
addAdc("FSBB_VIN_ADC", "ADCB_BASE", "ADC_CH_ADCIN0", 32);
addAdc("FSBB_VOUT_ADC", "ADCC_BASE", "ADC_CH_ADCIN1", 32);

const gpio = scripting.addModule("/driverlib/gpio.js", {}, false);
const enable = gpio.addInstance();
enable.$name = "FSBB_ENABLE_GATE";
enable.direction = "GPIO_DIR_MODE_OUT";
enable.writeInitialValue = true;
enable.initialValue = 0;
enable.gpioPin.$assign = "GPIO27";

const overcurrent = gpio.addInstance();
overcurrent.$name = "FSBB_OVERCURRENT";
overcurrent.qualMode = "GPIO_QUAL_ASYNC";
overcurrent.gpioPin.$assign = "GPIO31";

const led = gpio.addInstance();
led.$name = "SYSTEM_LED";
led.direction = "GPIO_DIR_MODE_OUT";
led.writeInitialValue = true;
led.initialValue = 1;
led.gpioPin.$assign = "GPIO34";

const trip = scripting.addModule("/driverlib/inputxbar.js", {}, false).addInstance();
trip.$name = "FSBB_TRIP_INPUT";
trip.inputsUsed = ["inputxbar1Gpio"];
trip.inputxbar1Gpio = "GPIO31";

const epwm = scripting.addModule("/driverlib/epwm.js", {}, false);
function addPwm(name, peripheral, pinA, pinB) {
    const instance = epwm.addInstance();
    instance.$name = name;
    instance.epwm.$assign = peripheral;
    instance.epwm.epwm_aPin.$assign = pinA;
    instance.epwm.epwm_bPin.$assign = pinB;
    instance.epwmTimebase_counterMode = "EPWM_COUNTER_MODE_UP_DOWN";
    instance.epwmTimebase_hsClockDiv = "EPWM_HSCLOCK_DIVIDER_1";
    instance.epwmTripZone_oneShotSource = ["EPWM_TZ_SIGNAL_OSHT1"];
    instance.epwmTripZone_EPWM_TZ_ACTION_EVENT_TZA = "EPWM_TZ_ACTION_LOW";
    instance.epwmTripZone_EPWM_TZ_ACTION_EVENT_TZB = "EPWM_TZ_ACTION_LOW";
    return instance;
}

const buck = addPwm("FSBB_BUCK_PWM", "EPWM1", "GPIO0", "GPIO1");
buck.epwmTimebase_syncOutPulseMode = "EPWM_SYNC_OUT_PULSE_ON_COUNTER_ZERO";
buck.epwmEventTrigger_EPWM_SOC_A_triggerEnable = true;
buck.epwmEventTrigger_EPWM_SOC_A_triggerSource = "EPWM_SOC_TBCTR_ZERO";
buck.epwmEventTrigger_EPWM_SOC_A_triggerEventPrescalar = "1";
const boost = addPwm("FSBB_BOOST_PWM", "EPWM2", "GPIO2", "GPIO3");
boost.epwmTimebase_phaseEnable = true;
boost.epwmTimebase_counterModeAfterSync = "EPWM_COUNT_MODE_UP_AFTER_SYNC";

const can = scripting.addModule("/driverlib/can.js", {}, false).addInstance();
can.$name = "LAUNCHXL_CAN";
can.can.$assign = "CANA";
can.can.can_rxPin.$assign = "GPIO33";
can.can.can_txPin.$assign = "GPIO32";
can.bitRate = "500000";
can.enableInterrupt = true;
can.registerInterrupts = true;
can.interruptFlags = ["CAN_INT_IE0"];
can.interruptLine = ["CAN_GLOBAL_INT_CANINT0"];
can.msgObjsUsed = [1, 2, 4, 5, 6, 7];
can.msgObj1.msgID = 0x101;
can.msgObj1.flags = ["CAN_MSG_OBJ_RX_INT_ENABLE"];
can.msgObj2.msgID = 0x102;
can.msgObj2.flags = ["CAN_MSG_OBJ_RX_INT_ENABLE"];
for (const id of [4, 5, 6, 7]) {
    can["msgObj" + id].msgID = 0x201 + id - 4;
    can["msgObj" + id].msgType = "CAN_MSG_OBJ_TYPE_TX";
    can["msgObj" + id].msgLen = 8;
}

const sci = scripting.addModule("/driverlib/sci.js", {}, false).addInstance();
sci.$name = "LAUNCHXL_UART_USB";
sci.selectRegisteredInterrupts = ["registerRxInt"];
sci.enabledFIFOInterrupts = ["SCI_INT_RXFF"];
sci.enabledErrorInterrupts = ["SCI_INT_FE", "SCI_INT_OE"];
sci.rxFifo = "SCI_FIFO_RX14";
sci.baudRates = 115200;
sci.sci.$assign = "SCIA";
sci.sci.sci_rxPin.$assign = "GPIO28";
sci.sci.sci_txPin.$assign = "GPIO29";
sci.sciRXInt.enableInterrupt = true;

{
  "id": "mcs_acim_nt_common",
  "macro_prefix": "MCS_ACIM_NT_COMMON",
  "display_name": "MCS ACIM NT Common Controller Settings",
  "description": "Platform-independent AC induction-motor FOC settings.",
  "suite": "mcs_acim_nt",
  "version": "0.1.0",
  "updated_at": "2026-08-15",
  "output_header": "sdpe_mcs_acim_nt_common_settings.h",
  "hardware": [],
  "code_sections": {
    "after_extern_open": "#define MCS_ACIM_FEEDBACK_SENSORED (1)\n#define MCS_ACIM_FEEDBACK_SENSORLESS (2)\n#define MCS_FO_VOLTAGE_FROM_COMMAND (1)\n#define MCS_FO_VOLTAGE_FROM_MEASUREMENT (2)",
    "before_footer": "#if (BUILD_LEVEL < 1) || (BUILD_LEVEL > 4)\n#error \"BUILD_LEVEL must be in the range 1..4.\"\n#endif\n#if (MCS_ACIM_FEEDBACK_MODE != MCS_ACIM_FEEDBACK_SENSORED) && (MCS_ACIM_FEEDBACK_MODE != MCS_ACIM_FEEDBACK_SENSORLESS)\n#error \"MCS_ACIM_FEEDBACK_MODE must select sensored or sensorless feedback.\"\n#endif\n#if (MCS_FO_VOLTAGE_SOURCE != MCS_FO_VOLTAGE_FROM_COMMAND) && (MCS_FO_VOLTAGE_SOURCE != MCS_FO_VOLTAGE_FROM_MEASUREMENT)\n#error \"MCS_FO_VOLTAGE_SOURCE must select command reconstruction or phase-voltage measurement.\"\n#endif"
  },
  "feature_macros": [
    {
      "group": "Control Algorithm",
      "macro": "ENABLE_ACIM_DECOUPLING",
      "enabled": true,
      "weak": false,
      "value": "",
      "description": "Apply ACIM-specific cross-coupling through the generic FOC feedforward port."
    },
    {
      "group": "Control Algorithm",
      "macro": "ENABLE_PWM_DEADTIME_COMPENSATION",
      "enabled": false,
      "weak": true,
      "value": "",
      "description": "Enable current-polarity PWM compare compensation for physical inverter dead time. Keep disabled for an ideal SIL bridge; identify the required count and current polarity on hardware."
    },
    {
      "group": "Protection",
      "macro": "ENABLE_MOTOR_FAULT_PROTECTION",
      "enabled": false,
      "weak": false,
      "value": "",
      "description": "Enable motor fault protection processing."
    }
  ],
  "option_macros": [
    {
      "group": "Controller Options",
      "macro": "BUILD_LEVEL",
      "enabled": true,
      "weak": true,
      "value": "(1)",
      "options": [
        "(1)",
        "(2)",
        "(3)",
        "(4)"
      ],
      "description": "Incremental commissioning gate: 1 open-angle V/f and PWM/ADC polarity; 2 I/F dq-current loop with synthetic field angle; 3 real field-angle current loop using external ACIM_POS_CALC or ACIM_FO; 4 mechanical speed loop. Do not advance until the previous level passes the commissioning record."
    },
    {
      "group": "Controller Options",
      "macro": "MCS_ACIM_FEEDBACK_MODE",
      "enabled": true,
      "weak": true,
      "value": "MCS_ACIM_FEEDBACK_SENSORED",
      "options": [
        "MCS_ACIM_FEEDBACK_SENSORED",
        "MCS_ACIM_FEEDBACK_SENSORLESS"
      ],
      "description": "Select speed-feedback IFOC or the voltage/current flux observer."
    },
    {
      "group": "Controller Options",
      "macro": "MCS_FO_VOLTAGE_SOURCE",
      "enabled": true,
      "weak": true,
      "value": "MCS_FO_VOLTAGE_FROM_COMMAND",
      "options": [
        "MCS_FO_VOLTAGE_FROM_COMMAND",
        "MCS_FO_VOLTAGE_FROM_MEASUREMENT"
      ],
      "description": "Select pre-dead-time controller command reconstruction or sampled phase voltage for the ACIM voltage model."
    }
  ],
  "requirements": [
    {
      "role": "Controller Frequency",
      "macro": "CONTROLLER_FREQUENCY",
      "binding": {
        "parameter": "20e3"
      },
      "description": "Fast-loop frequency in hertz."
    },
    {
      "role": "Motor Rs",
      "macro": "MOTOR_PARAM_RS",
      "weak": true,
      "binding": {
        "parameter": "0.329"
      }
    },
    {
      "role": "Motor Rr",
      "macro": "MOTOR_PARAM_RR",
      "weak": true,
      "binding": {
        "parameter": "0.44"
      }
    },
    {
      "role": "Motor L1s",
      "macro": "MOTOR_PARAM_L1S",
      "weak": true,
      "binding": {
        "parameter": "0.0003"
      }
    },
    {
      "role": "Motor L1r",
      "macro": "MOTOR_PARAM_L1R",
      "weak": true,
      "binding": {
        "parameter": "0.0005"
      }
    },
    {
      "role": "Motor Lm",
      "macro": "MOTOR_PARAM_LM",
      "weak": true,
      "binding": {
        "parameter": "0.0012"
      }
    },
    {
      "role": "Motor Pole Pairs",
      "macro": "MOTOR_PARAM_POLE_PAIRS",
      "weak": true,
      "binding": {
        "number": "2"
      }
    },
    {
      "role": "Motor Rated Frequency",
      "macro": "MOTOR_PARAM_RATED_FREQUENCY",
      "weak": true,
      "binding": {
        "parameter": "50.0"
      }
    },
    {
      "role": "Motor Maximum Speed",
      "macro": "MOTOR_PARAM_MAX_SPEED",
      "weak": true,
      "binding": {
        "parameter": "1450.0"
      }
    },
    {
      "role": "Synchronous Speed Base",
      "macro": "CTRL_SPEED_RPM_BASE",
      "binding": {
        "parameter": "1500.0"
      }
    },
    {
      "role": "Nominal DC Bus Voltage",
      "macro": "MCS_NOMINAL_DC_BUS_VOLTAGE_V",
      "binding": {
        "parameter": "48.0"
      }
    },
    {
      "role": "Rectangular Voltage Limit",
      "macro": "MCS_MAX_RECT_SATURATION_VOLTAGE_V",
      "binding": {
        "parameter": "24.0"
      }
    },
    {
      "role": "Circular Voltage Limit",
      "macro": "MCS_MAX_CIR_SATURATION_VOLTAGE_V",
      "binding": {
        "parameter": "24.0"
      }
    },
    {
      "role": "Deadtime Current Deadband",
      "macro": "MCS_PWM_DEADTIME_COMP_CURRENT_DEADBAND_A",
      "binding": {
        "parameter": "0.2"
      }
    },
    {
      "role": "Deadtime Current Hysteresis",
      "macro": "MCS_PWM_DEADTIME_COMP_CURRENT_HYSTERESIS_A",
      "binding": {
        "parameter": "0.05"
      }
    },
    {
      "role": "Open Loop Frequency",
      "macro": "MCS_OPEN_LOOP_FREQ_HZ",
      "binding": {
        "parameter": "30.0"
      }
    },
    {
      "role": "Open Loop Frequency Slope",
      "macro": "MCS_OPEN_LOOP_FREQ_SLOPE_HZ_S",
      "binding": {
        "parameter": "20.0"
      }
    },
    {
      "role": "Open Loop Vd",
      "macro": "MCS_OPEN_LOOP_VD_REF_V",
      "binding": {
        "parameter": "0.0"
      },
      "description": "Optional constant d-axis voltage boost for BUILD_LEVEL 1, in volts."
    },
    {
      "role": "Open Loop Vq",
      "macro": "MCS_OPEN_LOOP_VQ_REF_V",
      "binding": {
        "parameter": "6.0"
      },
      "description": "BUILD_LEVEL 1 q-axis voltage at MCS_OPEN_LOOP_FREQ_HZ. Runtime command is ramped proportionally with frequency (V/f)."
    },
    {
      "role": "Commissioning Id",
      "macro": "MCS_COMMISSIONING_ID_REF_A",
      "binding": {
        "parameter": "3.0"
      },
      "description": "Closed-loop ACIM magnetizing-current reference; unlike PMSM this normally must remain nonzero."
    },
    {
      "role": "Sensorless Startup Id",
      "macro": "MCS_SENSORLESS_STARTUP_ID_REF_A",
      "binding": {
        "parameter": "4.0"
      },
      "description": "High I/F startup excitation current before the observer is sufficiently observable."
    },
    {
      "role": "Sensorless Handover Id",
      "macro": "MCS_SENSORLESS_HANDOVER_ID_REF_A",
      "binding": {
        "parameter": "3.0"
      },
      "description": "I/F excitation reached at the angle-handover speed."
    },
    {
      "role": "Startup Id Fade Start",
      "macro": "MCS_STARTUP_ID_FADE_START_HZ",
      "binding": {
        "parameter": "5.0"
      },
      "description": "Absolute I/F electrical frequency where startup Id begins to decrease."
    },
    {
      "role": "Startup Id Fade End",
      "macro": "MCS_STARTUP_ID_FADE_END_HZ",
      "binding": {
        "parameter": "25.0"
      },
      "description": "Absolute I/F electrical frequency where startup Id reaches the handover value."
    },
    {
      "role": "Commissioning Iq",
      "macro": "MCS_COMMISSIONING_IQ_REF_A",
      "binding": {
        "parameter": "1.0"
      }
    },
    {
      "role": "Commissioning Speed",
      "macro": "MCS_COMMISSIONING_SPEED_REF_RPM",
      "binding": {
        "parameter": "300.0"
      }
    },
    {
      "role": "Magnetizing Time",
      "macro": "MCS_MAGNETIZING_TIME_MS",
      "binding": {
        "parameter": "300.0"
      }
    },
    {
      "role": "Mech Position Kp",
      "macro": "MCS_MECH_POSITION_KP_PU",
      "binding": {
        "parameter": "5.0"
      }
    },
    {
      "role": "Mech Position Ki",
      "macro": "MCS_MECH_POSITION_KI_PU_S",
      "binding": {
        "parameter": "1.0"
      }
    },
    {
      "role": "Mech Velocity Kp",
      "macro": "MCS_MECH_VELOCITY_KP_PU",
      "binding": {
        "parameter": "1.0"
      }
    },
    {
      "role": "Mech Velocity Ki",
      "macro": "MCS_MECH_VELOCITY_KI_PU_S",
      "binding": {
        "parameter": "10.0"
      }
    },
    {
      "role": "Mech Speed Limit",
      "macro": "MCS_MECH_SPEED_LIMIT_RPM",
      "binding": {
        "parameter": "1400.0"
      }
    },
    {
      "role": "Mech Speed Slope",
      "macro": "MCS_MECH_SPEED_SLOPE_RPM_S",
      "binding": {
        "parameter": "1000.0"
      }
    },
    {
      "role": "Mech Current Limit",
      "macro": "MCS_MECH_CURRENT_LIMIT_A",
      "binding": {
        "parameter": "3.0"
      }
    },
    {
      "role": "Encoder Speed Filter",
      "macro": "MCS_ENCODER_SPEED_FILTER_FC_HZ",
      "binding": {
        "parameter": "20.0"
      }
    },
    {
      "role": "Flux Observer Acquisition Crossover",
      "macro": "MCS_FO_COMP_BW_HZ",
      "binding": {
        "parameter": "20.0"
      },
      "description": "Current-model correction bandwidth while the known I/F field frame owns the current loop and initializes the voltage model."
    },
    {
      "role": "Flux Observer Run Crossover",
      "macro": "MCS_FO_RUN_COMP_BW_HZ",
      "binding": {
        "parameter": "0.5"
      },
      "description": "Post-handover correction bandwidth used only to reject voltage-integrator DC drift; keep it far below the sensorless operating frequency."
    },
    {
      "role": "Flux Observer VM Leak",
      "macro": "MCS_FO_VM_LEAK_HZ",
      "binding": {
        "parameter": "5.0"
      },
      "description": "Voltage-model leaky-integrator cutoff used to block DC voltage and current offsets. Keep it below the handover frequency and account for its phase lag during tuning."
    },
    {
      "role": "Flux Observer ATO Bandwidth",
      "macro": "MCS_FO_ATO_BW_HZ",
      "binding": {
        "parameter": "10.0"
      },
      "description": "Rotor-flux PLL bandwidth. A modest value avoids speed saturation from low-speed voltage-model phase error."
    },
    {
      "role": "Flux Observer Fault Time",
      "macro": "MCS_FO_FAULT_TIME_MS",
      "binding": {
        "parameter": "20.0"
      }
    },
    {
      "role": "Flux Observer Command Voltage Scale",
      "macro": "MCS_FO_COMMAND_VOLTAGE_SCALE",
      "weak": true,
      "binding": {
        "parameter": "0.5"
      },
      "description": "Multiply DC-bus PU by this target-specific modulator gain when reconstructing applied phase voltage from alpha-beta command."
    },
    {
      "role": "Sensorless Acquisition Frequency",
      "macro": "MCS_FO_ACQUIRE_FREQ_HZ",
      "binding": {
        "parameter": "10.0"
      },
      "description": "I/F electrical frequency at which the flux PLL is released to acquire the voltage-model angle while the current loop remains on the I/F field angle."
    },
    {
      "role": "Sensorless Handover Frequency",
      "macro": "MCS_FO_HANDOVER_FREQ_HZ",
      "binding": {
        "parameter": "25.0"
      },
      "description": "Minimum I/F electrical frequency before a qualified flux observer may take ownership of field angle. Keep this well above MCS_FO_COMP_BW_HZ so the voltage model has directional authority."
    },
    {
      "role": "Sensorless Handover Angle Error",
      "macro": "MCS_FO_HANDOVER_ANGLE_ERR_PU",
      "binding": {
        "parameter": "0.08"
      },
      "description": "Maximum wrapped angle mismatch in electrical-turn PU (1 pu = 360 degrees)."
    },
    {
      "role": "Sensorless Handover Speed Error",
      "macro": "MCS_FO_HANDOVER_SPEED_ERR_PU",
      "binding": {
        "parameter": "0.10"
      },
      "description": "Maximum observer-versus-I/F synchronous-speed mismatch in PU before the enforced startup synchronization is applied."
    },
    {
      "role": "Sensorless Handover Speed Exit Error",
      "macro": "MCS_FO_HANDOVER_SPEED_EXIT_ERR_PU",
      "binding": {
        "parameter": "0.15"
      },
      "description": "Larger speed mismatch that resets handover qualification; the gap above the enter tolerance is noise hysteresis."
    },
    {
      "role": "Sensorless Handover Debounce",
      "macro": "MCS_FO_HANDOVER_DEBOUNCE_MS",
      "binding": {
        "parameter": "100.0"
      },
      "description": "Continuous qualification time before the sensorless field-angle handover."
    },
    {
      "role": "Sensorless Handover Transition",
      "macro": "MCS_FO_HANDOVER_TRANSITION_MS",
      "binding": {
        "parameter": "100.0"
      },
      "description": "Time used to decay captured angle offset and synchronously blend startup Id to closed-loop Id."
    },
    {
      "role": "Sensorless Loss Speed Error",
      "macro": "MCS_FO_LOSS_SPEED_ERR_PU",
      "binding": {
        "parameter": "0.15"
      },
      "description": "Maximum post-handover synchronous-speed deviation from the continuing I/F reference before fallback qualification."
    },
    {
      "role": "Sensorless Loss Debounce",
      "macro": "MCS_FO_LOSS_DEBOUNCE_MS",
      "binding": {
        "parameter": "20.0"
      },
      "description": "Post-handover observer-loss debounce time. A confirmed loss latches I/F fallback until controllers are cleared."
    },
    {
      "role": "Maximum DC Bus Voltage",
      "macro": "MCS_MAX_DC_BUS_VOLTAGE_V",
      "binding": {
        "literal": "(MCS_NOMINAL_DC_BUS_VOLTAGE_V * 1.2f)"
      }
    },
    {
      "role": "Minimum DC Bus Voltage",
      "macro": "MCS_MIN_DC_BUS_VOLTAGE_V",
      "binding": {
        "literal": "(MCS_NOMINAL_DC_BUS_VOLTAGE_V * 0.2f)"
      }
    },
    {
      "role": "Maximum Shutdown Current",
      "macro": "MCS_MAX_SHUTDOWN_CURRENT_A",
      "binding": {
        "parameter": "10.0"
      }
    },
    {
      "role": "CiA402 Enable Delay",
      "macro": "MCS_CIA402_OPERATION_ENABLE_DELAY_MS",
      "binding": {
        "number": "0"
      }
    }
  ],

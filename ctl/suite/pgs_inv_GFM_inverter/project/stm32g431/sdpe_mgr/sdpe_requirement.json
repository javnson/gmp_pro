{
  "id": "pgs_inv_gfm_stm32g431",
  "macro_prefix": "PGS_INV_GFM_STM32G431",
  "display_name": "PGS GFM Inverter STM32G431",
  "description": "Nucleo-G431 platform timing and sensing settings for the common GFM controller.",
  "suite": "pgs_inv_GFM_inverter",
  "version": "1.0.0",
  "updated_at": "2026-08-15",
  "output_header": "ctrl_settings.h",
  "hardware": [
    {
      "entity": "nucleo_g431rb_motor_board"
    },
    {
      "entity": "gmp_helios_3phganinv_lv"
    },
    {
      "entity": "gmp_harmonia_3ph_lc_filter"
    }
  ],
  "code_sections": {
    "before_footer": "#if (BUILD_LEVEL < 1) || (BUILD_LEVEL > 5)\n#error BUILD_LEVEL_must_be_between_1_and_5\n#endif\n#if defined(USING_3D_SVPWM) && defined(USING_NPC_MODULATOR)\n#error USING_3D_SVPWM_and_USING_NPC_MODULATOR_are_mutually_exclusive\n#endif"
  },
  "feature_macros": [],
  "option_macros": [
    {
      "group": "Commissioning",
      "macro": "BUILD_LEVEL",
      "enabled": true,
      "value": "(1)",
      "options": [
        "(1)",
        "(2)",
        "(3)",
        "(4)",
        "(5)"
      ],
      "description": "BUILD_LEVEL descriptor: 1=open-loop voltage; 2=current loop with internal RG; 3=stand-alone LC capacitor-voltage loop; 4=PLL-oriented grid current loop; 5=PLL synchronization followed by bumpless transfer to the SDPE-selected droop, VSM, or virtual-impedance GFM outer loop plus voltage loop. USING_3D_SVPWM additionally requires a mapped fourth neutral-leg PWM."
    },
    {
      "group": "Sampling",
      "macro": "GFL_CURRENT_SAMPLE_PHASE_MODE",
      "enabled": true,
      "value": "(3)",
      "options": [
        "(2)",
        "(3)"
      ],
      "description": "Number of directly sampled phase currents."
    },
    {
      "group": "Sampling",
      "macro": "GFL_VOLTAGE_SAMPLE_PHASE_MODE",
      "enabled": true,
      "value": "(3)",
      "options": [
        "(2)",
        "(3)"
      ],
      "description": "Number of directly sampled phase voltages."
    }
  ],
  "requirements": [
    {
      "role": "Data Link Scope Depth",
      "macro": "GMP_DL_SCOPE_DEPTH",
      "enabled": true,
      "weak": false,
      "binding": {
        "number": "100"
      },
      "description": "Number of samples stored per channel by the four-channel hardware Data Link Scope."
    },
    {
      "role": "Startup Delay",
      "macro": "CTRL_STARTUP_DELAY",
      "binding": {
        "number": "100"
      },
      "description": "Startup delay in milliseconds."
    },
    {
      "role": "Controller Frequency",
      "macro": "CONTROLLER_FREQUENCY",
      "binding": {
        "parameter": "10e3"
      },
      "description": "Control interrupt frequency."
    },
    {
      "role": "Pwm Compare Max",
      "macro": "CTRL_PWM_CMP_MAX",
      "binding": {
        "number": "8500 - 1"
      },
      "description": "TIM compare range."
    },
    {
      "role": "Pwm Deadband",
      "macro": "CTRL_PWM_DEADBAND_CMP",
      "binding": {
        "number": "100"
      },
      "description": "TIM dead-time count."
    },
    {
      "role": "Adc Voltage Reference",
      "macro": "CTRL_ADC_VOLTAGE_REF",
      "binding": {
        "parameter": "3.3"
      },
      "description": "ADC reference."
    },
    {
      "role": "Dc Bus Voltage Base",
      "macro": "CTRL_DCBUS_VOLTAGE",
      "binding": {
        "parameter": "80.0"
      },
      "description": "DC-bus voltage base."
    },
    {
      "role": "Phase Voltage Base",
      "macro": "CTRL_VOLTAGE_BASE",
      "binding": {
        "literal": "(CTRL_DCBUS_VOLTAGE / 1.73205081f)"
      },
      "description": "SVPWM phase-voltage base."
    },
    {
      "role": "Current Base",
      "macro": "CTRL_CURRENT_BASE",
      "binding": {
        "parameter": "10.0"
      },
      "description": "Phase-current base."
    },
    {
      "role": "Grid Filter Inductance",
      "macro": "GFM_GRID_FILTER_INDUCTANCE_H",
      "binding": {
        "literal": "(HARMONIA_3PH_LC_FILTER_INDUCTANCE_H)"
      },
      "description": "Harmonia inductance."
    },
    {
      "role": "Grid Filter Capacitance",
      "macro": "GFM_GRID_FILTER_CAPACITANCE_F",
      "binding": {
        "literal": "(HARMONIA_3PH_LC_FILTER_CAPACITANCE_F)"
      },
      "description": "Harmonia capacitance."
    },
    {
      "role": "Grid Current Sensitivity",
      "macro": "CTRL_GRID_CURRENT_SENSITIVITY",
      "binding": {
        "literal": "(HARMONIA_3PH_LC_FILTER_PH_CURRENT_SENSITIVITY_MV_A * 0.001f)"
      },
      "description": "Grid-current sensitivity."
    },
    {
      "role": "Grid Current Bias",
      "macro": "CTRL_GRID_CURRENT_BIAS",
      "binding": {
        "literal": "(HARMONIA_3PH_LC_FILTER_PH_CURRENT_ZERO_BIAS_V)"
      },
      "description": "Grid-current bias."
    },
    {
      "role": "Grid Voltage Sensitivity",
      "macro": "CTRL_GRID_VOLTAGE_SENSITIVITY",
      "binding": {
        "literal": "(HARMONIA_3PH_LC_FILTER_PH_VOLTAGE_SENSE_GAIN)"
      },
      "description": "Grid-voltage gain."
    },
    {
      "role": "Grid Voltage Bias",
      "macro": "CTRL_GRID_VOLTAGE_BIAS",
      "binding": {
        "literal": "(HARMONIA_3PH_LC_FILTER_PH_VOLTAGE_SENSE_BIAS_V)"
      },
      "description": "Grid-voltage bias."
    },
    {
      "role": "Inverter Current Sensitivity",
      "macro": "CTRL_INVERTER_CURRENT_SENSITIVITY",
      "binding": {
        "parameter": "0.05"
      },
      "description": "Converter current sensitivity."
    },
    {
      "role": "Inverter Current Bias",
      "macro": "CTRL_INVERTER_CURRENT_BIAS",
      "binding": {
        "parameter": "1.65"
      },
      "description": "Converter current bias."
    },
    {
      "role": "Inverter Voltage Sensitivity",
      "macro": "CTRL_INVERTER_VOLTAGE_SENSITIVITY",
      "binding": {
        "parameter": "0.02738589"
      },
      "description": "Converter voltage gain."
    },
    {
      "role": "Inverter Voltage Bias",
      "macro": "CTRL_INVERTER_VOLTAGE_BIAS",
      "binding": {
        "parameter": "0.0"
      },
      "description": "Converter voltage bias."
    },
    {
      "role": "Dc Current Sensitivity",
      "macro": "CTRL_DC_CURRENT_SENSITIVITY",

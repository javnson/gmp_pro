{
  "id": "pgs_inv_gfl_common",
  "macro_prefix": "PGS_INV_GFL_COMMON",
  "display_name": "PGS Grid-Following Inverter Common Settings",
  "description": "Platform-independent control contract shared by all pgs_inv_GFL_inverter projects. Hardware timing, sensing, board resources and BUILD_LEVEL selection remain in each platform requirement.",
  "suite": "pgs_inv_GFL_inverter",
  "version": "1.2.0",
  "updated_at": "2026-07-28",
  "output_header": "sdpe_pgs_inv_gfl_common_settings.h",
  "hardware": [],
  "code_sections": {
    "after_extern_open": "/* Platform-independent GFL controller settings. */",
    "before_footer": "/* Accept the historical PIL spelling while new projects use the canonical switch. */\n#if defined ENBALE_GMP_DL_PIL_SIM && !defined ENABLE_GMP_DL_PIL_SIM\n#define ENABLE_GMP_DL_PIL_SIM\n#endif\n/* Four-leg hardware must explicitly acknowledge that A/B/C/N PWM and protection are mapped. */\n#if defined(USING_3D_SVPWM) && !defined(SPECIFY_PC_ENVIRONMENT) && !defined(GFL_3D_SVPWM_PLATFORM_MAPPED)\n#error Define_GFL_3D_SVPWM_PLATFORM_MAPPED_only_after_mapping_all_four_PWM_legs\n#endif"
  },
  "feature_macros": [
    {
      "group": "Control Algorithm",
      "macro": "_USE_DEBUG_DISCRETE_PID",
      "enabled": true,
      "value": "",
      "description": "Enable the existing discrete PID anti-saturation path."
    },
    {
      "group": "Control Algorithm",
      "macro": "USING_DSOGI_PLL",
      "enabled": false,
      "value": "",
      "description": "Use DSOGI PLL instead of the default SRF PLL."
    },
    {
      "group": "Control Algorithm",
      "macro": "USING_NPC_MODULATOR",
      "enabled": false,
      "value": "",
      "description": "Use the three-level NPC modulator instead of the two-level SPWM modulator."
    },
    {
      "group": "Control Algorithm",
      "macro": "USING_3D_SVPWM",
      "enabled": false,
      "value": "",
      "description": "Use four-leg 3D-SVPWM. This enables an independently controlled neutral-leg duty and permits zero-sequence QPR control; the selected board must provide a fourth PWM bridge leg."
    },
    {
      "group": "Control Algorithm",
      "macro": "GFL_ENABLE_VOLTAGE_DECOUPLE",
      "enabled": true,
      "value": "",
      "description": "Enable omega*C cross-coupling feed-forward in the BUILD_LEVEL 6 capacitor-voltage loop. Disable this switch to commission the voltage PI loop without decoupling."
    },
    {
      "group": "Control Algorithm",
      "macro": "GFL_ENABLE_VOLTAGE_CIRCLE_LIMIT",
      "enabled": true,
      "value": "",
      "description": "Enable circular magnitude limiting of the complete BUILD_LEVEL 6 d-q current reference."
    },
    {
      "group": "Control Algorithm",
      "macro": "GFL_ENABLE_VOLTAGE_SQUARE_LIMIT",
      "enabled": false,
      "value": "",
      "description": "Enable independent symmetric d/q-axis limiting of the complete BUILD_LEVEL 6 current reference."
    },
    {
      "group": "Control Algorithm",
      "macro": "GFL_ENABLE_PQ_DROOP",
      "enabled": true,
      "value": "",
      "description": "Enable frequency-P and voltage-Q droop reference generation ahead of the BUILD_LEVEL 5 P/Q controller."
    },
    {
      "group": "Runtime",
      "macro": "SPECIFY_ENABLE_ADC_CALIBRATE",
      "enabled": false,
      "value": "",
      "description": "Enable startup ADC offset calibration. Only enable while all calibrated power inputs are in a known zero state."
    },
    {
      "group": "Runtime",
      "macro": "ENABLE_GMP_DL_PIL_SIM",
      "enabled": false,
      "value": "",
      "description": "Enable processor-in-the-loop input/output handling."
    },
    {
      "group": "Runtime",
      "macro": "GMP_CTL_FM_CONFIG_ENABLE_DEBUG_INFO",
      "enabled": false,
      "value": "",
      "description": "Enable CiA402/GMP framework debug information."
    }
  ],
  "option_macros": [
    {
      "group": "Sampling",
      "macro": "GFL_CAPACITOR_CURRENT_CALCULATE_MODE",
      "enabled": true,
      "value": "(3)",
      "options": [
        "(1)",
        "(2)",
        "(3)"
      ],
      "description": "Capacitor-current source: direct measurement, current difference, or capacitor-voltage derivative."
    }
  ],
  "requirements": [
    {
      "role": "Grid Voltage Pu",
      "macro": "GFL_GRID_VOLTAGE_PU",
      "binding": {
        "float": "0.33"
      },
      "description": "Nominal grid phase-voltage magnitude in controller per unit."
    },
    {
      "role": "Grid Frequency",
      "macro": "GFL_GRID_FREQUENCY_HZ",
      "binding": {
        "float": "50.0"
      },
      "description": "Nominal grid frequency in hertz."
    },
    {
      "role": "Pq Loop Frequency",
      "macro": "GFL_PQ_LOOP_FREQUENCY_HZ",
      "binding": {
        "float": "1000.0"
      },
      "description": "P/Q outer-loop execution frequency in hertz."
    },
    {
      "role": "Pq Loop Divider",
      "macro": "GFL_PQ_LOOP_DIVIDER",
      "binding": {
        "literal": "((uint32_t)(CONTROLLER_FREQUENCY / GFL_PQ_LOOP_FREQUENCY_HZ))"
      },
      "description": "Current-ISR to P/Q-loop execution divider."
    },
    {
      "role": "Pq Active Kp",
      "macro": "GFL_PQ_ACTIVE_KP",
      "binding": {
        "float": "0.75"
      },
      "description": "Active-power loop proportional gain from P error PU to d-axis current PU."
    },
    {
      "role": "Pq Active Ki",
      "macro": "GFL_PQ_ACTIVE_KI",
      "binding": {
        "float": "0.001"
      },
      "description": "Active-power loop integral gain in inverse seconds."
    },
    {
      "role": "Pq Reactive Kp",
      "macro": "GFL_PQ_REACTIVE_KP",
      "binding": {
        "float": "0.75"
      },
      "description": "Reactive-power loop proportional gain from Q error PU to q-axis current PU."
    },
    {
      "role": "Pq Reactive Ki",
      "macro": "GFL_PQ_REACTIVE_KI",
      "binding": {
        "float": "0.001"
      },
      "description": "Reactive-power loop integral gain in inverse seconds."
    },
    {
      "role": "Pq Current Limit",
      "macro": "GFL_PQ_CURRENT_LIMIT_PU",
      "binding": {
        "float": "1.0"
      },
      "description": "Circular magnitude limit applied to the d/q current reference produced by the P/Q loop."
    },
    {
      "role": "Active Power Ref",
      "macro": "GFL_ACTIVE_POWER_REF_PU",
      "binding": {
        "float": "0.1"
      },
      "description": "Default active-power reference. Positive power exports energy to the grid."
    },
    {
      "role": "Reactive Power Ref",
      "macro": "GFL_REACTIVE_POWER_REF_PU",
      "binding": {
        "float": "0.0"
      },
      "description": "Default reactive-power reference using Q = vq*id - vd*iq."
    },
    {
      "role": "Pq Droop Lpf",
      "macro": "GFL_PQ_DROOP_LPF_HZ",
      "binding": {
        "float": "10.0"
      },
      "description": "PQ droop frequency and voltage measurement low-pass cutoff."
    },
    {
      "role": "Pq Droop P Gain",
      "macro": "GFL_PQ_DROOP_P_GAIN_PU_PER_HZ",
      "binding": {
        "float": "0.10"
      },
      "description": "Additional active-power command per hertz of frequency deficit."
    },
    {
      "role": "Pq Droop Q Gain",
      "macro": "GFL_PQ_DROOP_Q_GAIN_PU_PER_V_PU",
      "binding": {
        "float": "0.50"
      },
      "description": "Additional reactive-power command per PU of voltage deficit."
    },
    {
      "role": "Pq Droop P Min",
      "macro": "GFL_PQ_DROOP_P_MIN_PU",
      "binding": {
        "float": "-0.80"
      },
      "description": "Minimum active-power reference after PQ droop."
    },
    {
      "role": "Pq Droop P Max",
      "macro": "GFL_PQ_DROOP_P_MAX_PU",
      "binding": {
        "float": "0.80"
      },
      "description": "Maximum active-power reference after PQ droop."
    },
    {
      "role": "Pq Droop Q Min",
      "macro": "GFL_PQ_DROOP_Q_MIN_PU",
      "binding": {
        "float": "-0.80"
      },
      "description": "Minimum reactive-power reference after PQ droop."
    },
    {
      "role": "Pq Droop Q Max",
      "macro": "GFL_PQ_DROOP_Q_MAX_PU",
      "binding": {
        "float": "0.80"
      },
      "description": "Maximum reactive-power reference after PQ droop."
    },
    {
      "role": "Open Loop Vd",
      "macro": "GFL_OPEN_LOOP_VD_PU",
      "binding": {
        "float": "0.6"
      },
      "description": "BUILD_LEVEL 1 d-axis open-loop voltage command."
    },
    {
      "role": "Open Loop Vq",
      "macro": "GFL_OPEN_LOOP_VQ_PU",
      "binding": {
        "float": "0.6"
      },
      "description": "BUILD_LEVEL 1 q-axis open-loop voltage command."
    },
    {
      "role": "Level2 Id",
      "macro": "GFL_CURRENT_LEVEL2_ID_PU",
      "binding": {
        "float": "0.1"
      },
      "description": "BUILD_LEVEL 2 d-axis current command."
    },
    {
      "role": "Level2 Iq",
      "macro": "GFL_CURRENT_LEVEL2_IQ_PU",
      "binding": {
        "float": "0.1"
      },
      "description": "BUILD_LEVEL 2 q-axis current command."
    },
    {
      "role": "Level3 Id",
      "macro": "GFL_CURRENT_LEVEL3_ID_PU",
      "binding": {
        "float": "0.1"
      },
      "description": "BUILD_LEVEL 3 grid-connected d-axis current command."
    },
    {
      "role": "Level3 Iq",
      "macro": "GFL_CURRENT_LEVEL3_IQ_PU",
      "binding": {
        "float": "0.0"
      },
      "description": "BUILD_LEVEL 3 grid-connected q-axis current command."
    },
    {
      "role": "Level4 Id",
      "macro": "GFL_CURRENT_LEVEL4_ID_PU",
      "binding": {
        "float": "0.6"
      },
      "description": "BUILD_LEVEL 4 d-axis current command."
    },
    {
      "role": "Level4 Iq",
      "macro": "GFL_CURRENT_LEVEL4_IQ_PU",
      "binding": {
        "float": "0.6"
      },
      "description": "BUILD_LEVEL 4 q-axis current command."
    },
    {
      "role": "Standalone Voltage Vd",
      "macro": "GFL_STANDALONE_VD_PU",
      "binding": {
        "float": "0.50"
      },
      "description": "BUILD_LEVEL 6 positive-sequence d-axis capacitor phase-voltage reference in per unit."
    },
    {
      "role": "Standalone Voltage Vq",
      "macro": "GFL_STANDALONE_VQ_PU",
      "binding": {
        "float": "0.0"
      },
      "description": "BUILD_LEVEL 6 positive-sequence q-axis capacitor phase-voltage reference in per unit."
    },
    {
      "role": "Standalone Voltage Bw",
      "macro": "GFL_VOLTAGE_LOOP_BW_HZ",
      "binding": {
        "float": "100.0"
      },
      "description": "BUILD_LEVEL 6 capacitor-voltage outer-loop bandwidth in hertz; keep it well below the inner current-loop bandwidth."
    },
    {
      "role": "Standalone Voltage Zero",
      "macro": "GFL_VOLTAGE_LOOP_ZERO_HZ",
      "binding": {
        "float": "20.0"
      },
      "description": "BUILD_LEVEL 6 ordinary PI zero frequency in hertz."
    },
    {
      "role": "Standalone Circle Current Limit",
      "macro": "GFL_VOLTAGE_CIRCLE_LIMIT_PU",
      "binding": {
        "float": "0.80"
      },
      "description": "Circular magnitude limit for the complete BUILD_LEVEL 6 PI plus feed-forward current reference. The final limited output is returned to the ordinary PID integrators by clamping correction."
    },
    {
      "role": "Standalone Square Current Limit",
      "macro": "GFL_VOLTAGE_SQUARE_LIMIT_PU",
      "binding": {
        "float": "0.80"
      },
      "description": "Independent symmetric d/q-axis limit for the complete BUILD_LEVEL 6 PI plus feed-forward current reference."
    },
    {
      "role": "Zero Qpr Kp",
      "macro": "GFL_ZERO_QPR_KP",
      "binding": {
        "float": "0.10"
      },
      "description": "Zero-sequence current QPR proportional gain used when 3D-SVPWM is enabled."
    },
    {
      "role": "Zero Qpr Kr",
      "macro": "GFL_ZERO_QPR_KR",
      "binding": {
        "float": "50.0"
      },
      "description": "Zero-sequence current QPR resonant gain used when 3D-SVPWM is enabled."
    },
    {
      "role": "Zero Qpr Cutoff",
      "macro": "GFL_ZERO_QPR_CUTOFF_HZ",
      "binding": {
        "float": "5.0"
      },
      "description": "Zero-sequence QPR resonant bandwidth/cutoff frequency in hertz."
    },
    {
      "role": "Zero Voltage Limit",
      "macro": "GFL_ZERO_VOLTAGE_LIMIT_PU",
      "binding": {
        "float": "0.20"
      },
      "description": "Symmetric zero-axis voltage-command limit for four-wire operation."
    },
    {
      "role": "Adc Calibrator Cutoff",
      "macro": "GFL_ADC_CALIBRATOR_FC_HZ",
      "binding": {
        "float": "20.0"
      },
      "description": "ADC offset calibrator filter cutoff frequency."
    },
    {
      "role": "Adc Calibrator Q",
      "macro": "GFL_ADC_CALIBRATOR_Q",
      "binding": {
        "float": "0.707"
      },
      "description": "ADC offset calibrator second-order filter quality factor."
    },
    {
      "role": "Cia402 Enable Delay",
      "macro": "GFL_CIA402_OPERATION_ENABLE_DELAY_MS",
      "binding": {
        "number": "100"
      },
      "description": "Minimum CiA402 delay before Operation Enabled."
    },
    {
      "role": "Pll Lock Epsilon",
      "macro": "CTRL_SPLL_EPSILON",
      "binding": {
        "literal": "((float2ctrl(0.005)))"
      },
      "description": "PLL lock-error threshold in controller per unit."
    }
  ],
  "requirement_groups": [
    {
      "name": "Control Loop Parameters",
      "requirements": [
        "Grid Voltage Pu",
        "Pq Loop Frequency",
        "Pq Loop Divider",
        "Pq Active Kp",
        "Pq Active Ki",
        "Pq Reactive Kp",
        "Pq Reactive Ki",
        "Pq Current Limit",
        "Pq Droop Lpf",
        "Pq Droop P Gain",
        "Pq Droop Q Gain",
        "Pq Droop P Min",
        "Pq Droop P Max",
        "Pq Droop Q Min",
        "Pq Droop Q Max",
        "Open Loop Vd",
        "Open Loop Vq",
        "Pll Lock Epsilon"
      ]
    },
    {
      "name": "Commissioning Defaults",
      "requirements": [
        "Active Power Ref",
        "Reactive Power Ref",
        "Level2 Id",
        "Level2 Iq",
        "Level3 Id",
        "Level3 Iq",
        "Level4 Id",
        "Level4 Iq",
        "Standalone Voltage Vd",
        "Standalone Voltage Vq",
        "Standalone Voltage Bw",
        "Standalone Voltage Zero",
        "Standalone Circle Current Limit",
        "Standalone Square Current Limit",
        "Zero Qpr Kp",
        "Zero Qpr Kr",
        "Zero Qpr Cutoff",
        "Zero Voltage Limit"
      ]
    },
    {
      "name": "Runtime Parameters",
      "requirements": [
        "Adc Calibrator Cutoff",
        "Adc Calibrator Q",
        "Cia402 Enable Delay"
      ]
    },
    {
      "name": "Default Parameters",
      "requirements": [
        "Grid Frequency"
      ]
    }
  ]
}
